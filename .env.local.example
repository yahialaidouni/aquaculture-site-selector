# ──────────────────────────────────────────────────────────────
# Aquaculture Site Selector — environment variables
# ──────────────────────────────────────────────────────────────
#
# 1. Copy this file to .env.local in the same directory:
#      cp .env.local.example .env.local
#
# 2. Fill in the values below.
#
# 3. Restart `npm run dev` — Next.js reads env files at startup.
#
# .env.local is gitignored, so your credentials never leave your
# machine. They're only read on the server (inside API routes),
# never exposed to the browser.


# ── Copernicus Marine Service (optional) ──────────────────────
# Required for pH and dissolved oxygen.
# Sign up at https://marine.copernicus.eu/ (free, ~1 hour activation).
# If you don't set these, the app still works — pH and DO will just
# show "Configure Copernicus" in the UI.

CMEMS_USER=
CMEMS_PASSWORD=
